# Copy to ~/.config/learn/env (chmod 600). The systemd unit reads it; for a
# shell run: set -a; . ~/.config/learn/env; set +a; node ai/server.mjs

# DeepSeek (or any OpenAI-compatible chat completions endpoint). Stays server-side.
DEEPSEEK_API_KEY=
# LEARN_AI_API=https://api.deepseek.com/chat/completions
# LEARN_AI_MODEL=deepseek-chat

# A file holding one line, the passcode that unlocks chat/learn/commands. Reading stays public.
# LEARN_PASSCODE_FILE=~/.config/learn/passcode   # the default

# Your public origin(s), comma-separated; POSTs from other origins are refused.
LEARN_ORIGIN=https://learn.example.com

# Where things live (defaults shown; use absolute paths, ~ is not expanded)
# LEARN_CONTENT=~/learn                 # your .tex/.py/... files, one top-level folder per tab
# LEARN_DATA=~/.local/share/learn       # sessions, chats, time, lessons, undo log, trash
# LEARN_ROOT=/var/lib/learn             # built static site the servers read
# LEARN_PUBLISH_DIR=/var/lib/learn      # where deploy/publish.sh rsyncs the build
# LEARN_OUT=./dist

# Ports (both bind loopback; put a reverse proxy in front)
HOST=127.0.0.1
PORT=8075                             # ai/server.mjs (static server.mjs defaults to 8072)

# Daily caps on AI use (per-minute rate limits are built in)
LEARN_AI_DAILY_TOKENS=800000
LEARN_AI_DAILY_CALLS=200

# How the prompts refer to you
LEARNER_NAME=the learner
LEARNER_PROFILE=The learner is a CS student (comfortable in one language, picking up others)
